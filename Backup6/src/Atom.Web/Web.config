<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- 実際の値は環境ごとの Web.config 変換で設定します。ソースには平文で保持しません。 -->
    <add name="AtomDb"
         connectionString="
            Data Source=SQLAWS2;
            Initial Catalog=ATOM_dev;
            User ID=sa;
            Password=tajimatool;
            Integrated Security=False;
            Persist Security Info=False;
            Encrypt=True;
            TrustServerCertificate=True;
            Connect Timeout=30"
           providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />

    <!-- ATOM のシステムバージョン。ヘッダー表示とログイン履歴の version_no に使います。
         1画面完成ごとに 0.2.0 / 0.3.0 … と上げ、リリース時に 1.0.0 とします。 -->
    <add key="Atom.SystemVersion" value="0.1.0" />

    <!-- マニュアルの URL。新しいタブで開きます。空のときは「現在未実装です。」を表示します。 -->
    <add key="Atom.ManualUrl" value="" />

    <!-- 画面定義（メニュー構成・遷移先 URL・ヘッダー表示）のファイル。 -->
    <add key="Atom.ScreenCatalogPath" value="~/App_Data/AtomScreens.json" />

    <!-- 取込ファイルを一時的に置くフォルダ（サーバー上の絶対パス）。
         解析が終わったファイルは削除します。環境ごとに変更してください。 -->
    <add key="Atom.UploadFolderPath" value="C:\Users\itvendor06\Desktop\Input\ATOM\INVOICE取込" />

    <!-- ログの書き出し先。Sql / File / Trace のいずれか -->
    <add key="Log.Writer" value="Trace" />
    <!-- Log.Writer = Sql のとき: 出力先の接続名とテーブル名 -->
    <add key="Log.ConnectionName" value="AtomDb" />
    <add key="Log.TableName" value="" />
    <!-- Log.Writer = File のとき: 出力先フォルダ（サーバー上の絶対パス） -->
    <add key="Log.FolderPath" value="" />
    <!-- 記録する最小レベル。Information / Warning / Error -->
    <add key="Log.MinimumLevel" value="Information" />

    <!-- メール送信を行うか。false のとき送信せずログのみ記録する -->
    <add key="Mail.Enabled" value="false" />
    <!-- 差出人アドレス -->
    <add key="Mail.FromAddress" value="" />
    <!-- 検証用: 値があるとき、全宛先をこのアドレスへ差し替える（本番は空にする） -->
    <add key="Mail.RedirectTo" value="" />

    <!-- SVF 帳票定義ファイルの格納フォルダ -->
    <add key="Svf.FormFolderPath" value="" />
    <!-- 一時ファイルの作業フォルダ -->
    <add key="Svf.WorkFolderPath" value="" />
  </appSettings>

  <system.web>
    <!-- .aspx / .ascx / .master を UTF-8 として解析します。
         BOM が無いファイルでも日本語が文字化けしないようにするため明示します。 -->
    <globalization fileEncoding="utf-8"
                   requestEncoding="utf-8"
                   responseEncoding="utf-8"
                   culture="ja-JP"
                   uiCulture="ja-JP" />

    <!-- 規約に従い Option Strict / Explicit を既定で有効にします -->
    <compilation debug="true" strict="true" explicit="true" targetFramework="4.8.1" />

    <!-- maxRequestLength は KB 単位。Excel の取込に合わせて 10MB までとします。 -->
    <httpRuntime targetFramework="4.8.1" enableVersionHeader="false" requestValidationMode="4.5"
                 maxRequestLength="10240" executionTimeout="600" />

    <pages enableViewStateMac="true" maintainScrollPositionOnPostBack="true">
      <namespaces>
        <add namespace="Atom.Web" />
        <add namespace="Atom.Web.Common" />
      </namespaces>
    </pages>

    <!-- Session は IIS のメモリ上に保持します。
         アプリケーションプールのリサイクルで全利用者のログインが切れる点に注意してください。
         切れて困る場合は StateServer へ変更します（docs/01_ASP.NET_StateService_設定手順.md 参照）。 -->
    <sessionState mode="InProc"
                  timeout="60"
                  cookieless="false" />

    <!-- 社員コードのみで認証するため Windows 認証は使いません。 -->
    <authentication mode="None" />

    <customErrors mode="RemoteOnly" />

    <machineKey validation="HMACSHA256" decryption="AES" />
  </system.web>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

</configuration>
