root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.vb]
indent_style = space
indent_size = 4

[*.{aspx,ascx,master,asax,config,html}]
indent_style = space
indent_size = 4

[*.css]
indent_style = space
indent_size = 4

[*.{sql,md}]
indent_style = space
indent_size = 4
