Private Sub btn_auto_manual_Click()

    If Me![btn_auto_manual].Caption = "自動登録モード" Then
    
        Me![btn_auto_manual].Caption = "手動モード"
        
        intCalenderMode = 0
        
    Else
        Me![btn_auto_manual].Caption = "自動登録モード"
        
        intCalenderMode = 1
        
    End If
    
    Set cmd.ActiveConnection = conn
    
    strSql = "UPDATE tbl_t_calender_mode SET update_mode = " & intCalenderMode & ", update_ymd = '" & Now() & "', "
    strSql = strSql & "update_login = '" & Me![login_code] & "' FROM tbl_t_calender_mode "
    With cmd
        .CommandText = strSql
        .CommandType = adCmdText
        .Execute
    End With
    
    Set cmd = Nothing
    
End Sub

Private Sub btn_before_Click()

    '前月表示
    If IsNull(Me![taisyo_mm]) Then
        Me![taisyo_mm] = Month(Date)
    Else
        If Me![taisyo_mm] = 1 Then
            Me![taisyo_yyyy] = Me![taisyo_yyyy] - 1
            Me![taisyo_mm] = 12
        Else
            Me![taisyo_mm] = Me![taisyo_mm] - 1
        End If
    End If
    
    Call taisyo_mm_LostFocus
    
End Sub

Private Sub btn_next_Click()

    '翌月表示
    If IsNull(Me![taisyo_mm]) Then
        Me![taisyo_mm] = Month(Date)
    Else
        If Me![taisyo_mm] = 12 Then
            Me![taisyo_yyyy] = Me![taisyo_yyyy] + 1
            Me![taisyo_mm] = 1
        Else
            Me![taisyo_mm] = Me![taisyo_mm] + 1
        End If
    End If
    
    Call taisyo_mm_LostFocus
    
End Sub

Private Sub btn_print_Click()

    If IsNull(Me![login_code]) Then
        Call btn_setsuzoku_Click
    End If

    Dim intReportNo As Integer
    
    'ロジ配送予定表の印刷
    
    If IsNull(Me![print_start]) Then
    
        '印刷用日付が未入力だったら、今日から分にする
        Me![print_start] = Date
        Call print_start_AfterUpdate
    End If
    
    intReportNo = 0
    ReturnValue = InputBox("1:週次　2：月次", , 1)
    If Len(ReturnValue) <= 0 Then
        MsgBox ("レポートを選択して下さい")
        Exit Sub
    Else
        If ReturnValue <> 1 And ReturnValue <> 2 Then
            MsgBox ("1、または2を入力して下さい。")
            Exit Sub
        Else
            intReportNo = ReturnValue
        End If
    End If
    If intReportNo = 0 Then
        MsgBox ("レポートを選択して下さい")
        Exit Sub
    End If
    
    'REF_NOは、毎回更新してしまうと、見るだけで番号UPしてしまうので、必要な時だけ番号UP
    ReturnValue = MsgBox("最新番号を更新しますか？", 4 + vbDefaultButton2)
    If ReturnValue = vbYes Then
    
        Set cmd.ActiveConnection = conn
        
        '現在表示している番号＋1でテーブルをUPDATE
        strSql = "UPDATE tbl_t_shanghai_ref_no_kanri SET haiso_yotei_no = " & Me![haiso_yotei_no] + 1 & ", "
        strSql = strSql & "update_ymd = '" & Now() & "', update_login = '" & Me![login_code] & "' FROM tbl_t_shanghai_ref_no_kanri "
                
        With cmd
            .CommandText = strSql
            .CommandType = adCmdText
            .Execute
        End With
        
        '＋１の番号に表示しなおし
        Me![haiso_yotei_no] = Me![haiso_yotei_no] + 1
        Me![haiso_yotei_no].Requery
        
        Set cmd = Nothing
        
    End If

    'ロジ配送予定表OPEN
    If intReportNo = 1 Then
        DoCmd.OpenReport "R_ロジ配送予定表", acViewPreview, , "pk_yymmdd >= '" & Me![print_start] & "' AND pk_yymmdd <= '" & Me![print_end] & "' "
    Else
        DoCmd.OpenReport "R_ロジ配送予定表_monthly", acViewPreview, , "pk_yymmdd >= '" & DateSerial(Me![taisyo_yyyy], Me![taisyo_mm], 1) & "' AND pk_yymmdd <= '" & DateSerial(Me![taisyo_yyyy], Me![taisyo_mm] + 1, 1) - 1 & "' "
    End If
    
End Sub

Private Sub btn_setsuzoku_Click()

    Call Login_ReInput("F_M_CALENDER")
    intMenuNo = 904
    intMenuNoSeq = 0

End Sub

Private Sub Form_Open(Cancel As Integer)

    'フォームを開く時に、当月の情報を表示
    DoCmd.Maximize
    intMenuNo = 904
    intMenuNoSeq = 0
    
    Me![taisyo_yyyy] = Year(Date)
    Me![taisyo_mm] = Month(Date)
    
    Call taisyo_mm_LostFocus
    
    Set cmd.ActiveConnection = conn
    
    'ロジ配送予定表のREF_NOも表示
    With cmd
        .CommandText = "usp_shanghai_ref_no_get"
        .CommandType = adCmdStoredProc
        .Parameters.Refresh
        .Parameters(1) = "TY05-"
        .Execute
    End With
    If Not IsNull(cmd.Parameters(4)) Then
        Me![haiso_yotei_no] = cmd.Parameters(4)
    End If
    
    With cmd
        .CommandText = "usp_calender_mode_get"
        .CommandType = adCmdStoredProc
        .Parameters.Refresh
        .Execute
    End With
    If Not IsNull(cmd.Parameters(1)) And cmd.Parameters(1) = 1 Then
        Me![btn_auto_manual].Caption = "自動登録モード"
    Else
        Me![btn_auto_manual].Caption = "手動モード"
    End If
    
    Set cmd = Nothing
    
End Sub

Private Sub btn_menu_Click()

    If IsNull(Me![login_code]) Then
        Call btn_setsuzoku_Click
    End If

    'スタートメニューへ戻る
    strFormName = "F_0_START_MENU"
    
    intMenuNo = 0
    intMenuNoSeq = 0
    strOpenMode = "OC"
    Call form_open_close("F_M_CALENDER", strFormName, strOpenMode, "NULL")
    
End Sub

Private Sub btn_touroku_Click()

    '休日（日付横のH）の更新
    Call calender_mente("U", Me![taisyo_yyyy], Me![taisyo_mm], Me![frm_plant_kbn])
    
    Call taisyo_mm_LostFocus
    
End Sub

Private Sub frm_plant_kbn_Click()

    If IsNull(Me![taisyo_yyyy]) Or IsNull(Me![taisyo_mm]) Then
        Exit Sub
    End If

    'カレンダーフォームオープンのモジュールを、DISPLAYモードで実行
    Call calender_mente("D", Me![taisyo_yyyy], Me![taisyo_mm], Me![frm_plant_kbn])

End Sub

