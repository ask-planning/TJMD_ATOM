Private Sub PM42_DblClick(Cancel As Integer)

    Call Calender_Syosai_Input(Me![taisyo_yyyy], Me![taisyo_mm], Me![DAY42], "PM", Me![frm_plant_kbn])
    
End Sub

Private Sub print_start_AfterUpdate()

    'ロジ配送予定表の１枚に表示する期間は９日間（印刷物の見た目の具合のよさの期間）
    Me![print_end] = Me![print_start] + 9
    Me![print_end].Requery
    
End Sub

Private Sub taisyo_mm_LostFocus()

    If IsNull(Me![taisyo_yyyy]) Or IsNull(Me![taisyo_mm]) Then
        Exit Sub
    End If

    'カレンダーフォームオープンのモジュールを、DISPLAYモードで実行
    Call calender_mente("D", Me![taisyo_yyyy], Me![taisyo_mm], Me![frm_plant_kbn])
    
    
End Sub


