<!-- ================================================================
     connectionStrings.config のひな形

     このファイルをコピーして `connectionStrings.config` という名前にし、
     （サーバー）（ユーザー）（パスワード）を実際の値に置き換えてください。
     **値を入れたファイルはコミットしないこと。**

     ★どれが使われるかは Web.config の Atom.Environment で決まります。★
       3 本とも書いておき、コメントの開け閉めはしません。
       使わない環境の行を消しても構いませんが、切り替えたときに
       「接続文字列が設定されていません」で起動に失敗します。

     検証用データベースは ATOM_dev だけです。
     それ以外（ATOM / TJM_master / POEM）はすべて本番として扱ってください。
     ================================================================ -->
<connectionStrings>
  <!-- 開発 PC → 検証 DB -->
  <add name="AtomDb@Local" providerName="System.Data.SqlClient"
       connectionString="Data Source=（サーバー）;Initial Catalog=ATOM_dev;User ID=（ユーザー）;Password=（パスワード）;Integrated Security=False;Persist Security Info=False;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30" />

  <!-- 検証サーバー → 検証 DB -->
  <add name="AtomDb@Dev" providerName="System.Data.SqlClient"
       connectionString="Data Source=（サーバー）;Initial Catalog=ATOM_dev;User ID=（ユーザー）;Password=（パスワード）;Integrated Security=False;Persist Security Info=False;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30" />

  <!-- 本番サーバー → 本番 DB -->
  <add name="AtomDb@Prod" providerName="System.Data.SqlClient"
       connectionString="Data Source=（サーバー）;Initial Catalog=ATOM;User ID=（ユーザー）;Password=（パスワード）;Integrated Security=False;Persist Security Info=False;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30" />
</connectionStrings>
