<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- 実際の値は環境ごとの Web.config 変換で設定します。ソースには平文で保持しません。 -->
    <!-- ================================================================
         環境ごとの接続先
         使う環境のブロックだけコメントを外し、他はコメントにしてください。
         ★パスワードを含むため、値を入れた Web.config はコミットしないこと。
         ================================================================ -->

    <!-- ■ ローカル検証用（開発 PC → 検証 DB） ■ -->
    <add name="AtomDb" connectionString="             Data Source=SQLAWS2;             Initial Catalog=ATOM_dev;             User ID=sa;             Password=tajimatool;             Integrated Security=False;             Persist Security Info=False;             Encrypt=True;             TrustServerCertificate=True;             Connect Timeout=30" providerName="System.Data.SqlClient"/>
    <!-- ■ ここまで ローカル検証用 ■ -->

    <!-- ■ dev 公開用（新サーバー → 検証 DB） ■
    <add name="AtomDb" providerName="System.Data.SqlClient"
         connectionString="Data Source=（サーバー）;Initial Catalog=ATOM_dev;User ID=（ユーザー）;Password=（パスワード）;Integrated Security=False;Persist Security Info=False;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30"/>
    ■ ここまで dev 公開用 ■ -->

    <!-- ■ 本番用　★未記入。公開前に値を入れること ■
    <add name="AtomDb" providerName="System.Data.SqlClient"
         connectionString="Data Source=（サーバー）;Initial Catalog=ATOM;User ID=（ユーザー）;Password=（パスワード）;Integrated Security=False;Persist Security Info=False;Encrypt=True;TrustServerCertificate=True;Connect Timeout=30"/>
    ■ ここまで 本番用 ■ -->
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
    <!-- ATOM のシステムバージョン。ヘッダー表示とログイン履歴の version_no に使います。
         1画面完成ごとに 0.2.0 / 0.3.0 … と上げ、リリース時に 1.0.0 とします。 -->
    <add key="Atom.SystemVersion" value="0.1.0"/>
    <!-- マニュアルの URL。新しいタブで開きます。空のときは「現在未実装です。」を表示します。 -->
    <add key="Atom.ManualUrl" value=""/>
    <!-- 画面定義（メニュー構成・遷移先 URL・ヘッダー表示）のファイル。 -->
    <add key="Atom.ScreenCatalogPath" value="~/App_Data/AtomScreens.json"/>
    <!-- Log.Writer = Sql のとき: 出力先の接続名とテーブル名 -->
    <add key="Log.ConnectionName" value="AtomDb"/>
    <add key="Log.TableName" value=""/>
    <!-- 記録する最小レベル。Information / Warning / Error -->
    <add key="Log.MinimumLevel" value="Information"/>

    <!-- SVF は全環境で同じサーバーを使うため、ここは環境で変わりません。
         監視フォルダ / PDF の出力先 / 連携ファイルの制御部に書く論理プリンタ名。 -->
    <add key="Svf.WatchFolderPath" value="\\172.20.136.205\svfdata\data_atom"/>
    <add key="Svf.PdfFolderPath" value="\\172.20.136.205\svfdata\PDF\ATOM"/>
    <add key="Svf.OutputPrinter" value="HONKAN_PRNT01"/>

    <!-- ================================================================
         環境ごとの設定
         使う環境のブロックだけコメントを外し、他の 2 つはコメントにしてください。
         ここに無いキーは、どの環境でも同じ値です。
    
         Atom.UploadFolderPath : 取込ファイルを一時的に置くフォルダ（サーバー上の絶対パス）
         Log.Writer            : ログの書き出し先。Sql / File / Trace
         Log.FolderPath        : Log.Writer が File のときの出力先。書き込み権限が要る
         Mail.Enabled          : false のとき送信せずログのみ
         Mail.RedirectTo       : 値があると全宛先をここへ差し替える（本番は空）
         Poem.UpdateEnabled    : POEM の巻芯入出庫を更新するか
         Poem.MakishinProcedureName :
             ストアドが中で POEM.dbo.… と直接指定しており接続先に追従しない。
             そのため環境ごとに向き先の違うストアドを用意して切り替える。
             ★ここを間違えると別環境のデータを書き換える
             ================================================================ -->

    <!-- ■ ローカル検証用（開発 PC の IIS Express） ■ 
    <add key="Atom.UploadFolderPath" value="C:\Users\itvendor06\Desktop\Input\ATOM\INVOICE取込"/>
    <add key="Log.Writer" value="Trace"/>
    <add key="Log.FolderPath" value=""/>
    <add key="Mail.Enabled" value="false"/>
    <add key="Mail.FromAddress" value=""/>
    <add key="Mail.RedirectTo" value=""/>
    <add key="Poem.UpdateEnabled" value="false"/>
    <add key="Poem.MakishinProcedureName" value="usp_poem_makishin_nyu_syukko_update_dev"/>
     ■ ここまで ローカル検証用（開発 PC の IIS Express） ■ -->

    <!-- ■ dev 公開用（新サーバー / 検証 DB） ■ -->
    <add key="Atom.UploadFolderPath" value="D:\Systems\ATOM\upload"/>
    <add key="Log.Writer" value="File"/>
    <add key="Log.FolderPath" value="D:\Systems\ATOM\logs"/>
    <add key="Mail.Enabled" value="false"/>
    <add key="Mail.FromAddress" value=""/>
    <add key="Mail.RedirectTo" value=""/>
    <add key="Poem.UpdateEnabled" value="false"/>
    <add key="Poem.MakishinProcedureName" value="usp_poem_makishin_nyu_syukko_update_dev"/>
    <!-- ■ ここまで dev 公開用（新サーバー / 検証 DB） ■ -->

    <!-- ■ 本番用 ■
         ★公開前に接続先・パスを見直すこと
    <add key="Atom.UploadFolderPath" value="D:\Systems\ATOM\upload"/>
    <add key="Log.Writer" value="File"/>
    <add key="Log.FolderPath" value="D:\Systems\ATOM\logs"/>
    <add key="Mail.Enabled" value="false"/>
    <add key="Mail.FromAddress" value=""/>
    <add key="Mail.RedirectTo" value=""/>
    <add key="Poem.UpdateEnabled" value="false"/>
    <add key="Poem.MakishinProcedureName" value="usp_poem_makishin_nyu_syukko_update"/>
    ■ ここまで 本番用 ■ -->
  </appSettings>
  <system.web>
    <!-- .aspx / .ascx / .master を UTF-8 として解析します。
         BOM が無いファイルでも日本語が文字化けしないようにするため明示します。 -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="ja-JP" uiCulture="ja-JP"/>
    <!-- ================================================================
         SVF の共有へアクセスするための偽装

         SVF サーバーは社内、アプリのサーバーはクラウドで認証の土台が違うため、
         そのままでは \\（SVFサーバー）\svfdata へ繋がりません。
         ここで指定したアカウントになりすまして共有へアクセスします。

         【前提】userName のアカウントは、次の両方に同じパスワードで必要です。
            ・このアプリが動いているサーバー（ここでログオンするため）
            ・SVF サーバー（共有の権限を持たせるため）
           片方だけだと認証できません。

         【注意】
            ・パスワードは平文です。**値を入れた Web.config はコミットしないこと。**
            ・偽装はアプリ全体に効きます。ログの出力先など、他のファイル操作も
              このアカウントの権限で行われます。
            ・アプリケーションプールの ID を変える方法でも同じことができます
              （docs/05_IIS_配置手順.md §8-1）。どちらか一方だけにしてください。
         ================================================================ -->
    <!-- ■ 使うときはコメントを外して値を入れる ■
    <identity impersonate="true"
              userName="（ユーザー名）"
              password="（パスワード）" />
    ■ ここまで ■ -->

    <!-- 規約に従い Option Strict / Explicit を既定で有効にします -->
    <compilation debug="true" strict="true" explicit="true" targetFramework="4.8.1"/>
    <!-- maxRequestLength は KB 単位。Excel の取込に合わせて 10MB までとします。 -->
    <httpRuntime targetFramework="4.8.1" enableVersionHeader="false" requestValidationMode="4.5" maxRequestLength="10240" executionTimeout="600"/>
    <pages enableViewStateMac="true" maintainScrollPositionOnPostBack="true">
      <namespaces>
        <add namespace="Atom.Web"/>
        <add namespace="Atom.Web.Common"/>
      </namespaces>
    </pages>
    <!-- Session は IIS のメモリ上に保持します。
         アプリケーションプールのリサイクルで全利用者のログインが切れる点に注意してください。
         切れて困る場合は StateServer へ変更します（docs/01_ASP.NET_StateService_設定手順.md 参照）。 -->
    <sessionState mode="InProc" timeout="60" cookieless="false"/>
    <!-- 社員コードのみで認証するため Windows 認証は使いません。 -->
    <authentication mode="None"/>
    <customErrors mode="RemoteOnly"/>
    <machineKey validation="HMACSHA256" decryption="AES"/>
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
