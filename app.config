<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <connectionStrings>
    <!-- SQL Server認証。<USERID>/<PASSWORD> は環境に合わせて設定。資格情報はリポジトリにコミットしない運用を推奨（例: 環境ごとに config 変換や秘密管理を利用） -->
    <add name="AtomDb" 
		 connectionString="Data Source=SQLAWS2;
		                   Initial Catalog=ATOM_dev;
						   User ID=sa;
						   Password=tajimatool;" 
		 providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>
